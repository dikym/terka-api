# Managed by Ansible; changes here are overwritten.
# Single quotes make Compose take each value literally, so the JSON keeps its double quotes.
# Grafana sets the admin password only when it first creates its database.
GF_SECURITY_ADMIN_PASSWORD='{{ obs_grafana_admin_password }}'
GF_AUTH_JWT_JWK_SET_URL='https://{{ obs_access_team }}.cloudflareaccess.com/cdn-cgi/access/certs'
GF_AUTH_JWT_EXPECT_CLAIMS='{"aud":"{{ obs_access_aud }}"}'
