# Managed by Ansible; changes here are overwritten.
TERKA_ENV={{ item }}
TERKA_ADDR=:8080
TERKA_OTLP_ENDPOINT=alloy:4317
TERKA_DATABASE_URL=postgres://terka_{{ item }}_app:{{ terka_db_passwords[item].app | urlencode }}@postgres:5432/terka_{{ item }}
TERKA_AUTH_DATABASE_URL=postgres://terka_{{ item }}_auth:{{ terka_db_passwords[item].auth | urlencode }}@postgres:5432/terka_{{ item }}
TERKA_PUBLIC_URL={{ terka_auth[item].public_url }}
TERKA_AUTH_KEY={{ terka_auth[item].auth_key }}
TERKA_GOOGLE_CLIENT_ID={{ terka_auth[item].google_client_id }}
TERKA_GOOGLE_CLIENT_SECRET={{ terka_auth[item].google_client_secret }}
TERKA_TURNSTILE_SECRET={{ terka_auth[item].turnstile_secret }}
TERKA_TURNSTILE_HOSTNAMES={{ terka_auth[item].turnstile_hostnames }}
TERKA_SMTP_URL={{ terka_auth[item].smtp_url }}
TERKA_MAIL_FROM='{{ terka_auth[item].mail_from }}'
# Only Cloudflare reaches the origin (the console firewall), so its client address header is true.
TERKA_TRUST_CLOUDFLARE=true
